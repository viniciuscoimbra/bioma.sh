{
  "name": "@refy/ui",
  "version": "0.4.0",
  "description": "Refy Design System — componentes React atômicos.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./global.css": "./src/styles/global.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "audit:storybook": "node scripts/storybook-inventory.mjs",
    "audit:theme": "node scripts/theme-contrast.mjs",
    "audit:copy": "node scripts/copy-audit.mjs",
    "eval:copy": "node scripts/copy-eval.mjs",
    "email:harness": "node scripts/email-harness.mjs",
    "brand:generate": "node scripts/generate-domuz-brand-assets.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react-vite": "^8.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "mjml": "^5.4.0",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^8.3.0",
    "svg-path-bounds": "^1.0.2",
    "text-to-svg": "^3.1.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/prototypes/assets/brand",
    "src/tokens",
    "src/styles",
    "HANDOFF.md"
  ]
}
